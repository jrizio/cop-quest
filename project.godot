; Engine configuration file.
; Cop Quest — a Police Quest-style Sierra adventure (Godot 4).
; Edit in the editor (Project > Project Settings) rather than by hand where possible.

config_version=5

[application]

config/name="Cop Quest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
UI="*res://scripts/core/ui.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=200
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
